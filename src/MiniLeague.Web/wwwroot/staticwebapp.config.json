{
  "routes": [
    { "route": "/service-worker.js", "headers": { "cache-control": "no-cache" } },
    { "route": "/service-worker-assets.js", "headers": { "cache-control": "no-cache" } },
    { "route": "/manifest.webmanifest", "headers": { "cache-control": "no-cache" } }
  ],
  "mimeTypes": { ".webmanifest": "application/manifest+json" },
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/_framework/*", "/_content/*", "/css/*", "*.{css,js,wasm,dll,ico,png,jpg,webp,webmanifest,svg,json,dat,blat,woff,woff2,ttf}"]
  }
}
