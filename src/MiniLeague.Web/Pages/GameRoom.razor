    // Names the computer manager whose call is awaited, so the player knows who is making it.
    private string DecidingText
    {
        get
        {
            if (_game.State is not { } s) return "Computer deciding…";
            bool offenseIsComputer = (s.IsTopOfInning ? s.VisitorControl : s.HomeControl) == ManagerControl.Computer;
            bool visitor = offenseIsComputer == s.IsTopOfInning;   // the batting side if it is the computer, else the fielding side
            var persona = _game.PersonaFor(visitor);
            return persona is null ? "Computer deciding…" : $"{persona.Name} is deciding…";
        }
    }

    private void ResetGame()
    {
        _previewAlignment = null;
        _cpuCts?.Cancel();
        _game = new GameService(Resolver, CpuManager, Dice, ManagerCatalog.Default);
        _lastResult = null;
        _replay = null;
        _shown = null;
        _pendingIntro = false;
    }

    // ── Decision handlers ────────────────────────────────────────────────────

    // Humans supply the decision for each side they manage; the computer fills in the rest.
    private async Task HandleDecision((OffensiveDecision? Offense, DefensiveDecision? Defense) decision)
    {
        if (_animating) return;   // a play is still being shown
        try
        {
            // WHY: the computer defense answers the batter the human offense has announced, pinch hitter included.
            var planned = decision.Offense?.PinchHitterPlayerId is int pinchId
                ? _game.State!.OffenseTeam.Roster.FirstOrDefault(p => p.Id == pinchId) : null;
            var defense = decision.Defense ?? _game.GetComputerDefense(planned);
            await PreviewAlignmentAsync(defense.Alignment);
            _lastResult = _game.ExecutePlay(decision.Offense, defense);
            _previewAlignment = null;
        }
        catch (InvalidOperationException)
        {
            return;  // e.g. a double click after the game ended
        }

        bool animated = await AnimateLastPlayAsync();
        StateHasChanged();
        await PlayResultSounds(animated);
        await OfferInjuryReplacement();
        await SaveGame();
        await Task.Yield();
        ScheduleComputerTurnIfNeeded();
    }

    // WHY: alignment is chosen between plate appearances. Show the fielders moving before the pitch is resolved,
    // whether the choice came from a person or the computer manager.
    private async Task PreviewAlignmentAsync(DefensiveAlignment alignment)
    {
        if (_game.State is not { Status: GameStatus.InProgress } state || _animating) return;
        var current = _previewAlignment ?? (state.IsTopOfInning ? state.HomeAlignment : state.VisitorAlignment);
        if (current == alignment) return;

        PrePlaySnapshot before;
        try { before = (_shown ?? PrePlaySnapshot.Capture(state)) with { Alignment = current }; }
        catch (Exception ex) when (ex is InvalidOperationException or KeyNotFoundException or ArgumentException) { return; }

        _previewAlignment = alignment;
        _animating = true;
        StateHasChanged();
        try
        {
            if (ViewPrefs.View == FieldViewMode.Detailed && _detailed is not null)
                await _detailed.RepositionAsync(before, alignment, ViewPrefs.SpeedFactor);
            else if (ViewPrefs.View == FieldViewMode.Classic)
            {
                await Task.Yield();
                await Task.Delay(700);
            }
            _shown = before with { Alignment = alignment };
        }
        catch (Exception ex) when (ex is InvalidOperationException or KeyNotFoundException or ArgumentException) { }
        finally
        {
            _animating = false;
            StateHasChanged();
        }
    }

