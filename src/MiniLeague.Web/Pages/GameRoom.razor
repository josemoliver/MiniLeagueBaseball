@page "/game"
@using MiniLeague.Engine.Services
@inject AtBatResolver Resolver
@inject ComputerManager CpuManager
@inject SoundService Sound
@inject TeamRepository Teams
@inject IDialogService DialogService
@inject IGameSaveStore Saves
@inject Random Dice

@implements IDisposable

<PageTitle>Game Room — MiniLeague Baseball</PageTitle>

@if (_game.State is null)
{
    <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Style="min-height:60vh">
        <MudText Typo="Typo.h4" Align="Align.Center">MiniLeague Baseball</MudText>
        <MudText Typo="Typo.subtitle1" Class="mud-text-secondary" Align="Align.Center">
            Select a matchup to begin
        </MudText>

        @if (_resumeError is not null)
        {
            <MudAlert Severity="Severity.Warning" Dense="true" data-testid="resume-error">@_resumeError</MudAlert>
        }

        @if (_saved is not null && _teamOptions.Length > 0)
        {
            <MudCard Style="max-width:440px; width:100%" data-testid="resume-card">
                <MudCardContent>
                    <MudText Typo="Typo.overline">SAVED GAME</MudText>
                    <MudText Typo="Typo.h6">@_saved.Description</MudText>
                </MudCardContent>
                <MudCardActions>
                    <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="ResumeGame">RESUME</MudButton>
                    <MudButton OnClick="DiscardSave">DISCARD</MudButton>
                </MudCardActions>
            </MudCard>
        }

        @if (_loadError is not null)
        {
            <MudAlert Severity="Severity.Error">@_loadError</MudAlert>
        }
        else if (_teamOptions.Length == 0)
        {
            <MudProgressCircular Indeterminate="true" />
        }
        else
        {
        <MudCard Style="max-width:440px; width:100%">
            <MudCardContent>
                <MudStack Spacing="3">
                    <MudSelect T="int" Label="Visitor Team" @bind-Value="_visitorIdx"
                               ToStringFunc="@(i => _teamOptions[i].DisplayName)">
                        @for (int i = 0; i < _teamOptions.Length; i++)
                        {
                            int idx = i;
                            <MudSelectItem Value="idx">@_teamOptions[idx].DisplayName</MudSelectItem>
                        }
                    </MudSelect>
                    <MudSelect T="int" Label="Home Team" @bind-Value="_homeIdx"
                               ToStringFunc="@(i => _teamOptions[i].DisplayName)">
                        @for (int i = 0; i < _teamOptions.Length; i++)
                        {
                            int idx = i;
                            <MudSelectItem Value="idx">@_teamOptions[idx].DisplayName</MudSelectItem>
                        }
                    </MudSelect>
                    <MudSelect T="HumanSide" Label="You manage" @bind-Value="_humanSide">
                        <MudSelectItem Value="HumanSide.Visitor">Visitors (bat first)</MudSelectItem>
                        <MudSelectItem Value="HumanSide.Home">Home team</MudSelectItem>
                        <MudSelectItem Value="HumanSide.Both">Both teams (two players)</MudSelectItem>
                        <MudSelectItem Value="HumanSide.None">Neither (watch the computer)</MudSelectItem>
                    </MudSelect>
                    <MudSelect T="string" Label="Ballpark" @bind-Value="_stadiumChoice">
                        <MudSelectItem Value="@HomePark">Home team's park (@ParkNameOf(_teamOptions[_homeIdx]))</MudSelectItem>
                        @foreach (var park in _stadiums)
                        {
                            <MudSelectItem Value="@park.Id">@park.Name</MudSelectItem>
                        }
                    </MudSelect>
                    @foreach (var (label, visitorSide, team) in new[]
                    {
                        ("Visitor starting pitcher", true, _teamOptions[_visitorIdx]),
                        ("Home starting pitcher", false, _teamOptions[_homeIdx]),
                    })
                    {
                        bool side = visitorSide;
                        var club = team;
                        <MudSelect T="int" Label="@label" data-testid="@(side ? "visitor-starter" : "home-starter")"
                                   ToStringFunc="@(id => PlayerLabels.Pitcher(club.Pitchers.First(p => p.Id == id)))"
                                   Value="@StarterFor(club, side)"
                                   ValueChanged="@((int id) => _starters[(side, club.Id)] = id)">
                            @foreach (var p in club.StartingPitcherChoices)
                            {
                                <MudSelectItem T="int" Value="@p.Id">@PlayerLabels.Pitcher(p)</MudSelectItem>
                            }
                        </MudSelect>
                    }
                    <MudSwitch T="bool" @bind-Value="_randomEvents" Color="Color.Primary"
                               Label="Random events: injuries, rain delays, ejections" />
                    <MudStack Row="true" Spacing="2">
                        <MudButton Variant="Variant.Outlined" FullWidth="true" Size="Size.Small"
                                   OnClick="@(() => EditLineup(_teamOptions[_visitorIdx]))">
                            Visitor lineup
                        </MudButton>
                        <MudButton Variant="Variant.Outlined" FullWidth="true" Size="Size.Small"
                                   OnClick="@(() => EditLineup(_teamOptions[_homeIdx]))">
                            Home lineup
                        </MudButton>
                    </MudStack>
                </MudStack>
            </MudCardContent>
            <MudCardActions>
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           FullWidth="true" OnClick="StartGame">
                    PLAY BALL
                </MudButton>
            </MudCardActions>
        </MudCard>
        }
    </MudStack>
}
else
{
    var s = _game.State!;

    @* Phone: one column in the order you play. Desktop: the field on the left, decisions on the right.
       Very wide screens: field | decisions | lineups. (See GameRoom.razor.css.) *@
    <div class="game-layout">

        @* ── Scoreboard ─────────────────────────────────────────────────────── *@
        <div class="g-score">
            <MudPaper Class="pa-3" Elevation="2">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                    <div>
                        <MudText Typo="Typo.h6">@s.VisitorTeam.Abbreviation</MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary team-full">@s.VisitorTeam.DisplayName</MudText>
                    </div>
                    <MudStack AlignItems="AlignItems.Center" Spacing="0">
                        <MudText Typo="Typo.h4" Style="font-variant-numeric: tabular-nums; font-weight:700">
                            @s.VisitorTotalScore &nbsp;–&nbsp; @s.HomeTotalScore
                        </MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                            @InningLabel(s) @(s.Status == GameStatus.Final ? (s.EndedByRain ? "• FINAL (rain)" : "• FINAL") : "")
                        </MudText>
                    </MudStack>
                    <div style="text-align:right">
                        <MudText Typo="Typo.h6">@s.HomeTeam.Abbreviation</MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary team-full">@s.HomeTeam.DisplayName</MudText>
                    </div>
                </MudStack>
                <div class="sb-extra">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary" data-testid="park-name">@s.Stadium.Name</MudText>
                    @if (s.Status != GameStatus.Final)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary" data-testid="win-prob">@WinProbabilityLabel(s)</MudText>
                    }
                    <MudStack Row="true" Spacing="1">
                        <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="OpenBoxScore">Box score</MudButton>
                        <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="OpenRecap">Recap</MudButton>
                    </MudStack>
                </div>
            </MudPaper>
        </div>

        @* ── Inning-by-inning line score ──────────────────────────────────── *@
        <div class="g-line">
            <MudPaper Class="pa-2" Elevation="1">
                @{
                    int innings = Math.Max(9, s.CurrentInning);
                    bool live = s.Status != GameStatus.Final;
                }
                <div class="linescore-scroll">
                    <div class="linescore" data-testid="linescore"
                         style="@($"grid-template-columns: 60px repeat({innings}, minmax(1.5rem, 1fr)) 40px")">
                    <span class="ls-team">TEAM</span>
                    @for (int i = 1; i <= innings; i++) { <span class="ls-inn">@i</span> }
                    <span class="ls-tot">R</span>

                    <span class="ls-team">@s.VisitorTeam.Abbreviation</span>
                    @for (int inning = 1; inning <= innings; inning++)
                    {
                        <span class="ls-inn @(live && inning == s.CurrentInning && s.IsTopOfInning ? "active-inn" : "")">
                            @s.LineScoreCell(true, inning)
                        </span>
                    }
                    <span class="ls-tot">@s.VisitorTotalScore</span>

                    <span class="ls-team">@s.HomeTeam.Abbreviation</span>
                    @for (int inning = 1; inning <= innings; inning++)
                    {
                        <span class="ls-inn @(live && inning == s.CurrentInning && !s.IsTopOfInning ? "active-inn" : "")">
                            @s.LineScoreCell(false, inning)
                        </span>
                    }
                    <span class="ls-tot">@s.HomeTotalScore</span>
                    </div>
                </div>
            </MudPaper>
        </div>

        <div class="g-main">
            @* ── Field view ─────────────────────────────────────────────────── *@
            <div class="g-field">
                <FieldView LastResult="@_lastResult"
                           RunnerOnFirst="@s.RunnerOnFirst"
                           RunnerOnSecond="@s.RunnerOnSecond"
                           RunnerOnThird="@s.RunnerOnThird"
                           Game="@s"
                           Stadium="@s.Stadium"
                           CurrentPitcher="@s.CurrentPitcher.Player" />

            </div>
        </div>

        <div class="g-side">
            @* ── Decision panel (or final, injury, computer thinking) ────────── *@
            <div class="g-decision">
                @if (s.Status == GameStatus.Final)
                {
                    <MudPaper Class="pa-4" Elevation="3">
                        <MudStack AlignItems="AlignItems.Center" Spacing="2">
                            <MudText Typo="Typo.h5">FINAL</MudText>
                            <MudText Typo="Typo.h4" Style="font-weight:700">
                                @s.VisitorTeam.Abbreviation @s.VisitorTotalScore,
                                @s.HomeTeam.Abbreviation @s.HomeTotalScore
                            </MudText>
                            @if (s.EndedByRain)
                            {
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">Called because of rain</MudText>
                            }
                            <MudText Typo="Typo.body2" Class="mud-text-secondary" data-testid="decisions">@Decisions(s)</MudText>
                            <MudStack Row="true" Spacing="2">
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="OpenRecap">Game recap</MudButton>
                                <MudButton Variant="Variant.Outlined" OnClick="OpenBoxScore">Box score</MudButton>
                                <MudButton Variant="Variant.Outlined" OnClick="ResetGame">New Game</MudButton>
                            </MudStack>
                        </MudStack>
                    </MudPaper>
                }
                else if (s.PendingInjury is not null)
                {
                    <MudPaper Class="pa-3" Elevation="1" data-testid="injury-prompt">
                        <MudStack Spacing="2">
                            <MudAlert Severity="Severity.Warning" Dense="true">
                                @InjuredName(s) is injured and has to leave the game.
                            </MudAlert>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="OpenInjury">Choose a replacement</MudButton>
                        </MudStack>
                    </MudPaper>
                }
                else if (_game.IsHumanTurn)
                {
                    <MudPaper Class="pa-3" Elevation="1">
                        <DecisionPanel ShowOffense="@_game.OffenseIsHuman"
                                       ShowDefense="@_game.DefenseIsHuman"
                                       OnDecision="HandleDecision"
                                       OnSubstitutions="OpenSubstitutions"
                                       OnBoxScore="OpenBoxScore" />
                    </MudPaper>
                }
                else
                {
                    <MudPaper Class="pa-4" Elevation="1">
                        <MudStack AlignItems="AlignItems.Center" Spacing="2">
                            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Small" />
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">Computer deciding…</MudText>
                        </MudStack>
                    </MudPaper>
                }
            </div>

            @* ── What just happened ─────────────────────────────────────────── *@
            <div class="g-lastplay">
            @if (_lastResult is not null)
                {
                    <MudPaper Class="pa-3" Elevation="1"
                              Style="@($"border-left: 3px solid {ResultColor(_lastResult)}")">
                        <MudText Typo="Typo.body1" Style="font-weight:500">@_lastResult.Description</MudText>
                        @if (_lastResult.RunsScored > 0)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Success">
                                +@_lastResult.RunsScored run@(_lastResult.RunsScored > 1 ? "s" : "")
                            </MudText>
                        }
                    </MudPaper>
                }
            </div>

            @* ── Diamond, at bat, pitching ──────────────────────────────────── *@
            <div class="g-situation">
                <MudPaper Class="pa-3" Elevation="1">
                    <MudStack AlignItems="AlignItems.Center" Spacing="2">
                        <DiamondView RunnerOnFirst="@(s.RunnerOnFirst is not null)"
                                     RunnerOnSecond="@(s.RunnerOnSecond is not null)"
                                     RunnerOnThird="@(s.RunnerOnThird is not null)"
                                     Outs="@s.Outs" />
                    </MudStack>
                </MudPaper>

                <MudPaper Class="pa-3" Elevation="1">
                    <MudText Typo="Typo.overline">AT BAT</MudText>
                    <MudText Typo="Typo.h6" data-testid="at-bat-name">@s.CurrentBatter.Name</MudText>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        @LineupRules.Label(s.CurrentBatterPosition)
                        &nbsp;·&nbsp; @BatHandLabel(s.CurrentBatter.BatHand)
                    </MudText>
                    @if (s.CurrentBatter.Overall is BatterStats bs)
                    {
                        <MudText Typo="Typo.body2" Style="margin-top:4px">
                            .@Avg(bs) / @bs.HomeRuns HR / @bs.RBI RBI
                        </MudText>
                    }
                </MudPaper>

                <MudPaper Class="pa-3" Elevation="1">
                    <MudText Typo="Typo.overline">PITCHING</MudText>
                    <MudText Typo="Typo.h6">@s.CurrentPitcher.Player.Name</MudText>
                    @if (s.CurrentPitcher.Player.PitchingOverall is PitcherStats ps)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                            ERA @ps.ERA.ToString("F2") · @s.CurrentPitcher.PitchCount PC · @s.CurrentPitcher.RunsAllowed R
                        </MudText>
                    }
                    <MudChip T="string" Size="Size.Small"
                             Color="@ConditionColor(s.CurrentPitcher.Condition)"
                             Style="margin-top:4px">
                        @s.CurrentPitcher.Condition.ToString().ToUpperInvariant()
                    </MudChip>
                </MudPaper>

            </div>

            @* ── Play-by-play log ───────────────────────────────────────────── *@
            <div class="g-log">
                <MudPaper Class="pa-3" Elevation="1">
                    <MudText Typo="Typo.overline" Style="margin-bottom:6px;display:block">PLAY BY PLAY</MudText>
                    <PlayByPlayLog Events="@s.PlayByPlay" />
                </MudPaper>

            </div>
        </div>

        @* ── Lineups and benches ──────────────────────────────────────────── *@
        <div class="g-lineups">
            <LineupCard State="@s" Visitor="true" />
            <LineupCard State="@s" Visitor="false" />
        </div>

    </div>
}

@code {
    private Team[] _teamOptions = [];
    private string? _loadError;
    private int _visitorIdx = 0;
    private int _homeIdx = 1;
    private enum HumanSide { Visitor, Home, Both, None }
    private HumanSide _humanSide = HumanSide.Visitor;
    private IReadOnlyList<Stadium> _stadiums = [];
    private const string HomePark = "home";
    private string _stadiumChoice = HomePark;
    private bool _randomEvents = true;

    // Starting pitchers picked before the game, by side and team (anyone not picked starts the ace)
    private readonly Dictionary<(bool Visitor, int TeamId), int> _starters = [];

    private int StarterFor(Team team, bool visitor) =>
        _starters.TryGetValue((visitor, team.Id), out var id) && team.Pitchers.Any(p => p.Id == id)
            ? id
            : team.DefaultStarter.Id;
    private GameSnapshot? _saved;
    private string? _resumeError;
    private GameService _game = null!;
    private PlayResult? _lastResult;
    private CancellationTokenSource? _cpuCts;

    // Lineups edited before the game, by team ID (teams without an entry use their default)
    private readonly Dictionary<int, List<LineupSlot>> _customLineups = [];

    protected override async Task OnInitializedAsync()
    {
        _game = new GameService(Resolver, CpuManager, Dice);
        try
        {
            _teamOptions = [.. await Teams.GetTeamsAsync()];
            _homeIdx = Math.Min(1, _teamOptions.Length - 1);
            _stadiums = await Teams.GetStadiumsAsync();
            _saved = await Saves.LoadAsync();
        }
        catch (Exception ex) when (ex is HttpRequestException or System.Text.Json.JsonException)
        {
            _loadError = "Could not load team data.";
        }
    }

    private async Task StartGame()
    {
        _lastResult = null;
        bool visitorHuman = _humanSide is HumanSide.Visitor or HumanSide.Both;
        bool homeHuman = _humanSide is HumanSide.Home or HumanSide.Both;
        _game.StartGame(
            _teamOptions[_visitorIdx],
            _teamOptions[_homeIdx],
            visitorHuman ? ManagerControl.Human : ManagerControl.Computer,
            homeHuman ? ManagerControl.Human : ManagerControl.Computer,
            stadium: ChosenPark(),
            visitorLineupSlots: LineupFor(_teamOptions[_visitorIdx]),
            homeLineupSlots: LineupFor(_teamOptions[_homeIdx]),
            options: _randomEvents ? GameOptions.Standard : GameOptions.None,
            visitorStarterId: StarterFor(_teamOptions[_visitorIdx], visitor: true),
            homeStarterId: StarterFor(_teamOptions[_homeIdx], visitor: false));
        _ = Sound.PlayAsync("playball");
        await SaveGame();
        ScheduleComputerTurnIfNeeded();
    }

    private Stadium ChosenPark() =>
        Teams.FindStadium(_stadiumChoice == HomePark ? _teamOptions[_homeIdx].StadiumId : _stadiumChoice);

    private string ParkNameOf(Team team) => Teams.FindStadium(team.StadiumId).Name;

    // ── Save and resume ──────────────────────────────────────────────────────

    private async Task SaveGame()
    {
        if (_game.State is not null)
            await Saves.SaveAsync(_game.State);
    }

    private async Task ResumeGame()
    {
        if (_saved is null) return;
        try
        {
            _game.Resume(_saved, id => _teamOptions.FirstOrDefault(t => t.Id == id), id => Teams.FindStadium(id));
        }
        catch (InvalidOperationException ex)
        {
            _resumeError = ex.Message + " It has been discarded.";
            await Saves.ClearAsync();
            _saved = null;
            return;
        }

        _lastResult = null;
        _saved = null;
        _resumeError = null;
        await OfferInjuryReplacement();
        ScheduleComputerTurnIfNeeded();
    }

    private async Task DiscardSave()
    {
        await Saves.ClearAsync();
        _saved = null;
        _resumeError = null;
    }

    private IReadOnlyList<LineupSlot> LineupFor(Team team) =>
        _customLineups.TryGetValue(team.Id, out var custom) ? custom : LineupRules.Default(team);

    private async Task EditLineup(Team team)
    {
        var parameters = new DialogParameters<LineupEditorDialog>
        {
            { x => x.Team, team },
            { x => x.Current, LineupFor(team) },
        };
        var dialog = await DialogService.ShowAsync<LineupEditorDialog>(
            "Lineup", parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: List<LineupSlot> slots })
            _customLineups[team.Id] = slots;
    }

    private bool TwoHumans =>
        _game.State is { VisitorControl: ManagerControl.Human, HomeControl: ManagerControl.Human };

    // With one human it is their team; with two, start on the team that is batting.
    private bool HumanIsVisitor =>
        _game.State!.VisitorControl == ManagerControl.Human
        && (_game.State.HomeControl != ManagerControl.Human || _game.State.IsTopOfInning);

    private async Task OpenSubstitutions()
    {
        var parameters = new DialogParameters<SubstitutionDialog>
        {
            { x => x.Game, _game },
            { x => x.Visitor, HumanIsVisitor },
            { x => x.AllowSideChoice, TwoHumans },
        };
        var dialog = await DialogService.ShowAsync<SubstitutionDialog>(
            "Substitutions", parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        await dialog.Result;
        await Sound.PlayMomentsAsync(_game.TakeMoments());
        await SaveGame();
        StateHasChanged();
    }

    private void ResetGame()
    {
        _cpuCts?.Cancel();
        _game = new GameService(Resolver, CpuManager, Dice);
        _lastResult = null;
    }

    // ── Decision handlers ────────────────────────────────────────────────────

    // Humans supply the decision for each side they manage; the computer fills in the rest.
    private async Task HandleDecision((OffensiveDecision? Offense, DefensiveDecision? Defense) decision)
    {
        try
        {
            _lastResult = _game.ExecutePlay(decision.Offense, decision.Defense);
        }
        catch (InvalidOperationException)
        {
            return;  // e.g. a double click after the game ended
        }

        StateHasChanged();
        await PlayResultSounds();
        await OfferInjuryReplacement();
        await SaveGame();
        await Task.Yield();
        ScheduleComputerTurnIfNeeded();
    }

    // ── Box score and injuries ───────────────────────────────────────────────

    private async Task OpenRecap()
    {
        var parameters = new DialogParameters<RecapDialog> { { x => x.State, _game.State! } };
        await DialogService.ShowAsync<RecapDialog>("Game recap", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true });
    }

    // "Win probability: BOS 62%", for whichever team is ahead in the odds
    private static string WinProbabilityLabel(GameState s)
    {
        double home = s.HomeWinProbability;
        var team = home >= 0.5 ? s.HomeTeam : s.VisitorTeam;
        return $"Win probability: {team.Abbreviation} {GameRecaps.Percent(Math.Max(home, 1 - home))}";
    }

    private async Task OpenBoxScore()
    {
        var parameters = new DialogParameters<BoxScoreDialog> { { x => x.State, _game.State! } };
        await DialogService.ShowAsync<BoxScoreDialog>("Box Score", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true });
    }

    // After a play, a hurt player on a human-managed team must be replaced before anything else happens.
    private async Task OfferInjuryReplacement()
    {
        if (_game.State is not { PendingInjury: not null }) return;
        await OpenInjury();
    }

    private async Task OpenInjury()
    {
        var parameters = new DialogParameters<InjuryDialog> { { x => x.Game, _game } };
        var dialog = await DialogService.ShowAsync<InjuryDialog>("Injury", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, BackdropClick = false, CloseOnEscapeKey = false });
        await dialog.Result;
        await Sound.PlayMomentsAsync(_game.TakeMoments());
        await SaveGame();
        StateHasChanged();
        ScheduleComputerTurnIfNeeded();
    }

    private static string InjuredName(GameState s)
    {
        var n = s.PendingInjury!;
        var player = s.TeamFor(n.Visitor).Roster.First(p => p.Id == n.PlayerId);
        return $"{s.TeamFor(n.Visitor).Abbreviation} {player.Name}";
    }

    private static string Decisions(GameState s)
    {
        string Who(string decision) => string.Join(", ",
            new[] { s.Box.Visitor, s.Box.Home }
                .SelectMany(b => b.Pitchers).Where(p => p.Decision == decision).Select(p => p.Name));
        var parts = new List<string>();
        foreach (var (code, label) in new[] { ("W", "Win"), ("L", "Loss"), ("S", "Save") })
        {
            var who = Who(code);
            if (who.Length > 0) parts.Add($"{label}: {who}");
        }
        return string.Join(" · ", parts);
    }

    // ── Computer auto-play ───────────────────────────────────────────────────

    // Pause before each computer turn. A game with humans in it moves quickly; when the computer plays
    // both sides, each plate appearance gets a longer pause so the action can be followed.
    private static readonly TimeSpan HumanGamePause = TimeSpan.FromMilliseconds(600);
    private static readonly TimeSpan ComputerVsComputerPause = TimeSpan.FromSeconds(3);

    private bool ComputerVsComputer =>
        _game.State is { VisitorControl: ManagerControl.Computer, HomeControl: ManagerControl.Computer };

    /// <param name="songHold">How long a song from the previous play still has to run; the next turn waits for it.</param>
    private void ScheduleComputerTurnIfNeeded(TimeSpan songHold = default)
    {
        if (_game.State?.Status != GameStatus.InProgress) return;
        if (_game.IsHumanTurn || _game.State.PendingInjury is not null) return;

        _cpuCts?.Cancel();
        _cpuCts = new CancellationTokenSource();
        var token = _cpuCts.Token;
        var pause = (ComputerVsComputer ? ComputerVsComputerPause : HumanGamePause) + songHold;

        _ = Task.Run(async () =>
        {
            await Task.Delay(pause, token);
            if (token.IsCancellationRequested) return;
            await InvokeAsync(async () =>
            {
                _lastResult = _game.ExecuteComputerTurn();
                StateHasChanged();
                var song = await PlayResultSounds();
                _ = SaveGame();
                if (_game.State?.PendingInjury is not null)
                    _ = OpenInjury();
                else
                    ScheduleComputerTurnIfNeeded(song);
            });
        }, token);
    }

    /// <summary>Plays the sounds for the last play. Returns how long any organ tune will run.</summary>
    private async Task<TimeSpan> PlayResultSounds()
    {
        if (_lastResult is null) return TimeSpan.Zero;
        await Sound.PlayForResultAsync(_lastResult);
        var moments = _game.TakeMoments();
        if (_game.State?.Status == GameStatus.Final)
        {
            await Sound.PlayAsync("gameover");
            return TimeSpan.Zero;
        }
        return await Sound.PlayMomentsAsync(moments);
    }

    public void Dispose() => _cpuCts?.Cancel();

    // ── Display helpers ──────────────────────────────────────────────────────

    private static string InningLabel(GameState s)
    {
        string half = s.IsTopOfInning ? "▲" : "▼";
        return $"{half} {s.CurrentInning}";
    }

    private static string Avg(BatterStats b)
    {
        string raw = b.BattingAverage.ToString("F3");
        return raw.StartsWith("0") ? raw[1..] : raw;  // strip leading 0 → .320
    }

    private static string PositionLabel(MiniLeague.Engine.Models.Position p) => p switch
    {
        MiniLeague.Engine.Models.Position.P      => "P",
        MiniLeague.Engine.Models.Position.C      => "C",
        MiniLeague.Engine.Models.Position.First  => "1B",
        MiniLeague.Engine.Models.Position.Second => "2B",
        MiniLeague.Engine.Models.Position.Third  => "3B",
        MiniLeague.Engine.Models.Position.Short  => "SS",
        MiniLeague.Engine.Models.Position.Left   => "LF",
        MiniLeague.Engine.Models.Position.Center => "CF",
        MiniLeague.Engine.Models.Position.Right  => "RF",
        MiniLeague.Engine.Models.Position.DH     => "DH",
        _ => p.ToString()
    };

    private static string BatHandLabel(BatHand b) => b switch
    {
        BatHand.Left => "L", BatHand.Right => "R", _ => "S"
    };

    private static Color ConditionColor(PitcherCondition c) => c switch
    {
        PitcherCondition.Fresh     => Color.Success,
        PitcherCondition.Ok        => Color.Info,
        PitcherCondition.Tiring    => Color.Warning,
        PitcherCondition.Tired     => Color.Error,
        PitcherCondition.Exhausted => Color.Dark,
        _ => Color.Default
    };

    private static string ResultColor(PlayResult r)
    {
        if (r.IsHit)  return r.Outcome == OutcomeType.HomeRun ? "#ff8f00" : "#4caf50";
        if (r.IsOut)  return "#ef5350";
        if (r.IsWalk) return "#42a5f5";
        return "#78909c";
    }
}
