@page "/game"
@using MiniLeague.Engine.Services
@using MiniLeague.Engine.Animation
@inject AtBatResolver Resolver
@inject ComputerManager CpuManager
@inject SoundService Sound
@inject FieldViewPreferences ViewPrefs
@inject TeamRepository Teams
@inject IDialogService DialogService
@inject IGameSaveStore Saves
@inject CastService Cast
@inject Random Dice
@inject IJSRuntime JS

@implements IDisposable

<PageTitle>Game Room — MiniLeague Baseball</PageTitle>

@if (_game.State is null)
{
    <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Style="min-height:60vh" Class="game-setup">
        <MudText Typo="Typo.h4" Align="Align.Center">MiniLeague Baseball</MudText>
        <MudText Typo="Typo.subtitle1" Class="mud-text-secondary" Align="Align.Center">
            Select a matchup to begin
        </MudText>

        @if (_resumeError is not null)
        {
            <MudAlert Severity="Severity.Warning" Dense="true" data-testid="resume-error">@_resumeError</MudAlert>
        }

        @if (_saved is not null && _teamOptions.Length > 0)
        {
            <MudCard Style="max-width:440px; width:100%" data-testid="resume-card">
                <MudCardContent>
                    <MudText Typo="Typo.overline">SAVED GAME</MudText>
                    <MudText Typo="Typo.h6">@_saved.Description</MudText>
                </MudCardContent>
                <MudCardActions>
                    <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="ResumeGame">RESUME</MudButton>
                    <MudButton OnClick="DiscardSave">DISCARD</MudButton>
                </MudCardActions>
            </MudCard>
        }

        @if (_loadError is not null)
        {
            <MudAlert Severity="Severity.Error">@_loadError</MudAlert>
        }
        else if (_teamOptions.Length == 0)
        {
            <MudProgressCircular Indeterminate="true" />
        }
        else
        {
        <MudCard Class="game-setup-card" Style="max-width:620px; width:100%">
            <div class="matchup-preview" data-testid="matchup-preview">
                <div class="matchup-eyebrow">MATCHUP CARD</div>
                <div class="matchup-teams">
                    <div class="matchup-team">
                        <span class="matchup-side">VISITORS</span>
                        <strong>@_teamOptions[_visitorIdx].Abbreviation</strong>
                        <span>@_teamOptions[_visitorIdx].DisplayName</span>
                        <small>Starter: @_teamOptions[_visitorIdx].Pitchers.First(p => p.Id == StarterFor(_teamOptions[_visitorIdx], true)).Name</small>
                    </div>
                    <span class="matchup-vs">VS</span>
                    <div class="matchup-team matchup-home">
                        <span class="matchup-side">HOME</span>
                        <strong>@_teamOptions[_homeIdx].Abbreviation</strong>
                        <span>@_teamOptions[_homeIdx].DisplayName</span>
                        <small>Starter: @_teamOptions[_homeIdx].Pitchers.First(p => p.Id == StarterFor(_teamOptions[_homeIdx], false)).Name</small>
                    </div>
                </div>
                <div class="matchup-park">@ChosenPark().Name · @(ViewPrefs.View == FieldViewMode.Classic ? "Classic field" : "Detailed field")</div>
            </div>
            <MudCardContent>
                <MudStack Spacing="3">
                    <MudSelect T="int" Label="Visitor Team" @bind-Value="_visitorIdx"
                               ToStringFunc="@(i => _teamOptions[i].DisplayName)">
                        @for (int i = 0; i < _teamOptions.Length; i++)
                        {
                            int idx = i;
                            <MudSelectItem Value="idx">@_teamOptions[idx].DisplayName</MudSelectItem>
                        }
                    </MudSelect>
                    <MudSelect T="int" Label="Home Team" @bind-Value="_homeIdx"
                               ToStringFunc="@(i => _teamOptions[i].DisplayName)">
                        @for (int i = 0; i < _teamOptions.Length; i++)
                        {
                            int idx = i;
                            <MudSelectItem Value="idx">@_teamOptions[idx].DisplayName</MudSelectItem>
                        }
                    </MudSelect>
                    <MudSelect T="HumanSide" Label="You manage" @bind-Value="_humanSide">
                        <MudSelectItem Value="HumanSide.Visitor">Visitors (bat first)</MudSelectItem>
                        <MudSelectItem Value="HumanSide.Home">Home team</MudSelectItem>
                        <MudSelectItem Value="HumanSide.Both">Both teams (two players)</MudSelectItem>
                        <MudSelectItem Value="HumanSide.None">Neither (watch the computer)</MudSelectItem>
                    </MudSelect>
                    <details class="setup-options" data-testid="setup-options">
                        <summary>
                            <span>Game options</span>
                            <small>Ballpark · starters · field · events · hints · lineups</small>
                        </summary>
                        <div class="setup-options-content">
                            <MudStack Spacing="3">
                                <MudSelect T="string" Label="Ballpark" @bind-Value="_stadiumChoice">
                                    <MudSelectItem Value="@HomePark">Home team's park (@ParkNameOf(_teamOptions[_homeIdx]))</MudSelectItem>
                                    @foreach (var park in _stadiums)
                                    {
                                        <MudSelectItem Value="@park.Id">@park.Name</MudSelectItem>
                                    }
                                </MudSelect>
                                @foreach (var (label, visitorSide, team) in new[]
                                {
                                    ("Visitor starting pitcher", true, _teamOptions[_visitorIdx]),
                                    ("Home starting pitcher", false, _teamOptions[_homeIdx]),
                                })
                                {
                                    bool side = visitorSide;
                                    var club = team;
                                    <MudSelect T="int" Label="@label" data-testid="@(side ? "visitor-starter" : "home-starter")"
                                               ToStringFunc="@(id => PlayerLabels.Pitcher(club.Pitchers.First(p => p.Id == id)))"
                                               Value="@StarterFor(club, side)"
                                               ValueChanged="@((int id) => _starters[(side, club.Id)] = id)">
                                        @foreach (var p in club.StartingPitcherChoices)
                                        {
                                            <MudSelectItem T="int" Value="@p.Id">@PlayerLabels.Pitcher(p)</MudSelectItem>
                                        }
                                    </MudSelect>
                                }
                                <MudSelect T="DesignatedHitterSetting" Label="Designated hitter" data-testid="dh-setting"
                                           @bind-Value="_dhSetting" ToStringFunc="@DesignatedHitterLabel" HelperText="@DesignatedHitterHelp">
                                    @foreach (var choice in Enum.GetValues<DesignatedHitterSetting>())
                                    {
                                        <MudSelectItem Value="@choice">@DesignatedHitterLabel(choice)</MudSelectItem>
                                    }
                                </MudSelect>
                                <MudSelect T="FieldViewMode" Label="Field view" data-testid="field-view-select"
                                           Value="@ViewPrefs.View" ValueChanged="SetView">
                                    <MudSelectItem Value="FieldViewMode.Classic">Classic (overhead)</MudSelectItem>
                                    <MudSelectItem Value="FieldViewMode.Detailed">Detailed (animated plays)</MudSelectItem>
                                </MudSelect>
                                <MudSwitch T="bool" @bind-Value="_randomEvents" Color="Color.Primary"
                                           Label="Random events: injuries, rain delays, ejections" />
                                <MudSwitch T="bool" @bind-Value="_showPlayHints" Color="Color.Primary"
                                           Label="Show Play Hints" data-testid="show-play-hints" />
                                <MudStack Row="true" Spacing="2">
                                    <MudButton Variant="Variant.Outlined" FullWidth="true" Size="Size.Small"
                                               OnClick="@(() => EditLineup(_teamOptions[_visitorIdx], visitor: true))">
                                        Visitor lineup
                                    </MudButton>
                                    <MudButton Variant="Variant.Outlined" FullWidth="true" Size="Size.Small"
                                               OnClick="@(() => EditLineup(_teamOptions[_homeIdx], visitor: false))">
                                        Home lineup
                                    </MudButton>
                                </MudStack>
                            </MudStack>
                        </div>
                    </details>
                    @* The managers come after the game options so the options keep their place in the form. *@
                    @if (_humanSide is not (HumanSide.Visitor or HumanSide.Both))
                    {
                        <ManagerChooser Label="Visitors' computer manager" TestId="visitor-manager"
                                        Value="@_visitorManagerId" ValueChanged="@(id => _visitorManagerId = id)" />
                    }
                    @if (_humanSide is not (HumanSide.Home or HumanSide.Both))
                    {
                        <ManagerChooser Label="Home computer manager" TestId="home-manager"
                                        Value="@_homeManagerId" ValueChanged="@(id => _homeManagerId = id)" />
                    }
                </MudStack>
            </MudCardContent>
            <MudCardActions>
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           FullWidth="true" OnClick="StartGame">
                    PLAY BALL
                </MudButton>
            </MudCardActions>
        </MudCard>
        }
    </MudStack>
}
else
{
    var s = _game.State!;

    @* Phone: one column in the order you play. Desktop: the field on the left, decisions on the right.
       Very wide screens: field | decisions | lineups. (See GameRoom.razor.css.) *@
    <div class="game-layout">

        <div class="mobile-score" @ref="_mobileScore" data-testid="mobile-score" aria-label="Current score">
            <span class="mobile-score-teams">@s.VisitorTeam.Abbreviation <strong>@s.VisitorTotalScore</strong><span class="mobile-score-divider">–</span>@s.HomeTeam.Abbreviation <strong>@s.HomeTotalScore</strong></span>
            <span class="mobile-score-inning">@(s.Status == GameStatus.Final ? "FINAL" : $"{InningLabel(s)} · {s.Outs} out{(s.Outs == 1 ? "" : "s")}")</span>
            <span class="mobile-score-bases" role="img" aria-label="@BaseSituation(s)">
                <span class="@(s.RunnerOnThird is null ? "" : "occupied")" aria-hidden="true">◆</span>
                <span class="@(s.RunnerOnSecond is null ? "" : "occupied")" aria-hidden="true">◆</span>
                <span class="@(s.RunnerOnFirst is null ? "" : "occupied")" aria-hidden="true">◆</span>
            </span>
        </div>

        @* ── Scoreboard ─────────────────────────────────────────────────────── *@
        <div class="g-score" @ref="_fullScore">
            <MudPaper Class="pa-3" Elevation="2">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                    <div>
                        <MudText Typo="Typo.h6">@s.VisitorTeam.Abbreviation</MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary team-full">@s.VisitorTeam.DisplayName</MudText>
                    </div>
                    <MudStack AlignItems="AlignItems.Center" Spacing="0">
                        <MudText Typo="Typo.h4" Style="font-variant-numeric: tabular-nums; font-weight:700">
                            @s.VisitorTotalScore &nbsp;–&nbsp; @s.HomeTotalScore
                        </MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                            @InningLabel(s) @(s.Status == GameStatus.Final ? (s.EndedByRain ? "• FINAL (rain)" : "• FINAL") : "")
                        </MudText>
                    </MudStack>
                    <div style="text-align:right">
                        <MudText Typo="Typo.h6">@s.HomeTeam.Abbreviation</MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary team-full">@s.HomeTeam.DisplayName</MudText>
                    </div>
                </MudStack>
                <div class="sb-extra">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary" data-testid="park-name">@s.Stadium.Name</MudText>
                    @if (Cast.IsCasting)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Warning" data-testid="casting-note">The field is on the TV</MudText>
                    }
                    @if (s.Status != GameStatus.Final)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary" data-testid="win-prob">@WinProbabilityLabel(s)</MudText>
                    }
                    <MudStack Row="true" Spacing="1">
                        <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="OpenBoxScore">Box score</MudButton>
                        <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="OpenRecap">Recap</MudButton>
                    </MudStack>
                    <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" data-testid="view-switch">
                        <MudButton Size="Size.Small" Color="Color.Primary" data-testid="view-classic"
                                   Variant="@(ViewPrefs.View == FieldViewMode.Classic ? Variant.Filled : Variant.Text)"
                                   OnClick="@(() => SetView(FieldViewMode.Classic))">Classic</MudButton>
                        <MudButton Size="Size.Small" Color="Color.Primary" data-testid="view-detailed"
                                   Variant="@(ViewPrefs.View == FieldViewMode.Detailed ? Variant.Filled : Variant.Text)"
                                   OnClick="@(() => SetView(FieldViewMode.Detailed))">Detailed</MudButton>
                        @if (ViewPrefs.View == FieldViewMode.Detailed)
                        {
                            @foreach (var speed in Enum.GetValues<AnimationSpeed>())
                            {
                                var chosen = speed;
                                <MudButton Size="Size.Small" Color="Color.Secondary" data-testid="@($"speed-{chosen.ToString().ToLowerInvariant()}")"
                                           Variant="@(ViewPrefs.Speed == chosen ? Variant.Filled : Variant.Text)"
                                           OnClick="@(() => SetSpeed(chosen))">@chosen</MudButton>
                            }
                        }
                    </MudStack>
                </div>
            </MudPaper>
        </div>

        @* ── Inning-by-inning line score ──────────────────────────────────── *@
        <div class="g-line">
            <MudPaper Class="pa-2" Elevation="1">
                @{
                    int innings = Math.Max(9, s.CurrentInning);
                    bool live = s.Status != GameStatus.Final;
                }
                <div class="linescore-scroll">
                    <div class="linescore" data-testid="linescore"
                         style="@($"grid-template-columns: 60px repeat({innings}, minmax(1.5rem, 1fr)) 40px")">
                    <span class="ls-team">TEAM</span>
                    @for (int i = 1; i <= innings; i++) { <span class="ls-inn">@i</span> }
                    <span class="ls-tot">R</span>

                    @* A run flashes the total and the inning it came in: a changed @key makes a new element, which restarts the animation. *@
                    <span class="ls-team">@s.VisitorTeam.Abbreviation</span>
                    @for (int inning = 1; inning <= innings; inning++)
                    {
                        bool active = live && inning == s.CurrentInning && s.IsTopOfInning;
                        string cell = s.LineScoreCell(true, inning);
                        <span class="ls-inn @(active ? "active-inn" : "") @(active && cell is not ("0" or "-" or "X") ? "ls-flash" : "")" @key="@($"v{inning}-{cell}")">
                            @cell
                        </span>
                    }
                    <span class="ls-tot @(s.VisitorTotalScore > 0 ? "ls-flash" : "")" @key="@($"vt{s.VisitorTotalScore}")">@s.VisitorTotalScore</span>

                    <span class="ls-team">@s.HomeTeam.Abbreviation</span>
                    @for (int inning = 1; inning <= innings; inning++)
                    {
                        bool active = live && inning == s.CurrentInning && !s.IsTopOfInning;
                        string cell = s.LineScoreCell(false, inning);
                        <span class="ls-inn @(active ? "active-inn" : "") @(active && cell is not ("0" or "-" or "X") ? "ls-flash" : "")" @key="@($"h{inning}-{cell}")">
                            @cell
                        </span>
                    }
                    <span class="ls-tot @(s.HomeTotalScore > 0 ? "ls-flash" : "")" @key="@($"ht{s.HomeTotalScore}")">@s.HomeTotalScore</span>
                    </div>
                </div>
            </MudPaper>
        </div>

        <div class="g-main">
            @* ── Field view ─────────────────────────────────────────────────── *@
            @* WHY: while a TV shows the field, this page gives up the space. The animated field stays mounted (parked
               off-screen, see .cast-away) instead of being removed: it still draws the plays that js/cast.js passes on to
               the TV, and its animations set the pace of the game. Removing it would stall the TV and speed the game up.
               NOTE: the Classic field has nothing to relay, so it is simply not drawn while casting. *@
            <div class="g-field @(Cast.IsCasting ? "cast-away" : "")" data-testid="field-region">
                @if (ViewPrefs.View == FieldViewMode.Detailed)
                {
                    <DetailedFieldView @ref="_detailed" Game="@s" Stadium="@s.Stadium" OnReady="OnDetailedReady"
                                       CanReplay="@(_replay is not null && !_animating)" OnReplay="ReplayAsync" />
                }
                else if (!Cast.IsCasting)
                {
                    <FieldView LastResult="@_lastResult"
                               RunnerOnFirst="@s.RunnerOnFirst"
                               RunnerOnSecond="@s.RunnerOnSecond"
                               RunnerOnThird="@s.RunnerOnThird"
                               Game="@s"
                               Alignment="@(_previewAlignment ?? (s.IsTopOfInning ? s.HomeAlignment : s.VisitorAlignment))"
                               Stadium="@s.Stadium"
                               CurrentPitcher="@s.CurrentPitcher.Player" />
                }

            </div>
        </div>

        <div class="g-side">
            @* ── Decision panel (or final, injury, computer thinking) ────────── *@
            <div class="g-decision">
                @if (s.Status == GameStatus.Final)
                {
                    <MudPaper Class="pa-4" Elevation="3">
                        <MudStack AlignItems="AlignItems.Center" Spacing="2">
                            <MudText Typo="Typo.h5">FINAL</MudText>
                            <MudText Typo="Typo.h4" Style="font-weight:700">
                                @s.VisitorTeam.Abbreviation @s.VisitorTotalScore,
                                @s.HomeTeam.Abbreviation @s.HomeTotalScore
                            </MudText>
                            @if (s.EndedByRain)
                            {
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">Called because of rain</MudText>
                            }
                            <MudText Typo="Typo.body2" Class="mud-text-secondary" data-testid="decisions">@Decisions(s)</MudText>
                            <MudStack Row="true" Spacing="2">
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="OpenRecap">Game recap</MudButton>
                                <MudButton Variant="Variant.Outlined" OnClick="OpenBoxScore">Box score</MudButton>
                                <MudButton Variant="Variant.Outlined" OnClick="ResetGame">New Game</MudButton>
                            </MudStack>
                        </MudStack>
                    </MudPaper>
                }
                else if (s.PendingInjury is not null)
                {
                    <MudPaper Class="pa-3" Elevation="1" data-testid="injury-prompt">
                        <MudStack Spacing="2">
                            <MudAlert Severity="Severity.Warning" Dense="true">
                                @InjuredName(s) is injured and has to leave the game.
                            </MudAlert>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="OpenInjury">Choose a replacement</MudButton>
                        </MudStack>
                    </MudPaper>
                }
                else if (_game.IsHumanTurn)
                {
                    <MudPaper Class="pa-3" Elevation="1">
                        <div class="pitch-context" data-testid="pitch-context">
                            <div class="pitch-context-top">
                                <span>AT THIS PITCH</span>
                                <strong>@(s.IsTopOfInning ? "TOP" : "BOTTOM") @s.CurrentInning · @s.Outs OUT@((s.Outs == 1) ? "" : "S")</strong>
                            </div>
                            <div class="pitch-context-matchup">
                                <strong>@s.CurrentBatter.Name</strong><span>vs</span><strong>@s.CurrentPitcher.Player.Name</strong>
                            </div>
                            <div class="pitch-context-bases">@BaseSituation(s)</div>
                        </div>
                        <DecisionPanel ShowOffense="@_game.OffenseIsHuman"
                                       ShowDefense="@_game.DefenseIsHuman"
                                       ShowHints="@s.Options.ShowPlayHints"
                                       HintAvailable="@CanOpenHint()"
                                       HintRemainingText="@HintButtonLabel()"
                                       CanSteal="@(s.RunnerOnFirst is not null && s.RunnerOnSecond is null)"
                                       StealCall="@RunningRules.StealPlanFor(s)"
                                       CanSqueeze="@(s.RunnerOnThird is not null && s.Outs < 2)"
                                       AlignmentMoving="@_animating"
                                       OnAlignmentChanged="PreviewAlignmentAsync"
                                       OnDecision="HandleDecision"
                                       OnSubstitutions="OpenSubstitutions"
                                       OnBoxScore="OpenBoxScore"
                                       OnHint="OpenHint" />
                    </MudPaper>
                }
                else
                {
                    <MudPaper Class="pa-4" Elevation="1">
                        <MudStack AlignItems="AlignItems.Center" Spacing="2">
                            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Small" />
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">@DecidingText</MudText>
                        </MudStack>
                    </MudPaper>
                }
            </div>

            @* ── Diamond, at bat, pitching ──────────────────────────────────── *@
            <div class="g-situation">
                <MudPaper Class="pa-3" Elevation="1">
                    <MudStack AlignItems="AlignItems.Center" Spacing="2">
                        <DiamondView RunnerOnFirst="@(s.RunnerOnFirst is not null)"
                                     RunnerOnSecond="@(s.RunnerOnSecond is not null)"
                                     RunnerOnThird="@(s.RunnerOnThird is not null)"
                                     Outs="@s.Outs" />
                    </MudStack>
                </MudPaper>

                <MudPaper Class="pa-3" Elevation="1">
                    <MudText Typo="Typo.overline">AT BAT</MudText>
                    <MudText Typo="Typo.h6" data-testid="at-bat-name">@s.CurrentBatter.Name</MudText>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        @LineupRules.Label(s.CurrentBatterPosition)
                        &nbsp;·&nbsp; @BatHandLabel(s.CurrentBatter.BatHand)
                    </MudText>
                    @if (s.CurrentBatter.Overall is BatterStats bs)
                    {
                        <MudText Typo="Typo.body2" Style="margin-top:4px">
                            .@Avg(bs) / @bs.HomeRuns HR / @bs.RBI RBI
                        </MudText>
                    }
                </MudPaper>

                <button type="button" class="mobile-pitching-toggle" aria-expanded="@_mobilePitchingExpanded"
                        aria-controls="pitching-details" @onclick="() => _mobilePitchingExpanded = !_mobilePitchingExpanded"
                        data-testid="mobile-pitching-toggle">
                    <span>Pitching · @s.CurrentPitcher.Player.Name</span><span aria-hidden="true">@(_mobilePitchingExpanded ? "−" : "+")</span>
                </button>
                <div id="pitching-details" class="pitching-details @(_mobilePitchingExpanded ? "expanded" : "")">
                <MudPaper Class="pa-3" Elevation="1">
                    <MudText Typo="Typo.overline">PITCHING</MudText>
                    <MudText Typo="Typo.h6">@s.CurrentPitcher.Player.Name</MudText>
                    @if (s.CurrentPitcher.Player.PitchingOverall is PitcherStats ps)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                            ERA @ps.ERA.ToString("F2") · @s.CurrentPitcher.PitchCount PC · @s.CurrentPitcher.RunsAllowed R
                        </MudText>
                    }
                    <MudChip T="string" Size="Size.Small"
                             Color="@ConditionColor(s.CurrentPitcher.Condition)"
                             Style="margin-top:4px">
                        @s.CurrentPitcher.Condition.ToString().ToUpperInvariant()
                    </MudChip>
                </MudPaper>
                </div>

            </div>

            @* ── Play-by-play log ───────────────────────────────────────────── *@
            <div class="g-log">
                <MudPaper Class="pa-3" Elevation="1">
                    <MudText Typo="Typo.overline" Style="margin-bottom:6px;display:block">LAST CALLS · PLAY BY PLAY</MudText>
                    @* WHY: the game records a play before its Detailed animation finishes. Give the log a snapshot so
                       a child render cannot reveal the new entry ahead of the field. *@
                    <PlayByPlayLog Events="@s.PlayByPlay.ToArray()" />
                </MudPaper>
                @if (ViewPrefs.View == FieldViewMode.Classic && _lastResult is not null)
                {
                    <div class="sr-only" role="status">@_lastResult.Description</div>
                }
            </div>
        </div>

        @* ── Lineups and benches ──────────────────────────────────────────── *@
        <div class="g-lineups">
            <div class="mobile-lineup-tabs" role="tablist" aria-label="Team lineups">
                <button type="button" role="tab" id="lineup-visitor-tab" aria-controls="lineup-visitor-panel"
                        aria-selected="@_mobileLineupVisitor" @onclick="() => _mobileLineupVisitor = true">@s.VisitorTeam.Abbreviation lineup</button>
                <button type="button" role="tab" id="lineup-home-tab" aria-controls="lineup-home-panel"
                        aria-selected="@(!_mobileLineupVisitor)" @onclick="() => _mobileLineupVisitor = false">@s.HomeTeam.Abbreviation lineup</button>
            </div>
            <div class="lineup-panel @(_mobileLineupVisitor ? "selected" : "")" id="lineup-visitor-panel" role="tabpanel" aria-labelledby="lineup-visitor-tab">
                <LineupCard State="@s" Visitor="true" />
            </div>
            <div class="lineup-panel @(!_mobileLineupVisitor ? "selected" : "")" id="lineup-home-panel" role="tabpanel" aria-labelledby="lineup-home-tab">
                <LineupCard State="@s" Visitor="false" />
            </div>
        </div>

    </div>
}

@code {
    private Team[] _teamOptions = [];
    private string? _loadError;
    private int _visitorIdx = 0;
    private int _homeIdx = 1;
    private enum HumanSide { Visitor, Home, Both, None }
    private HumanSide _humanSide = HumanSide.Visitor;
    private IReadOnlyList<Stadium> _stadiums = [];
    private const string HomePark = "home";
    private string _stadiumChoice = HomePark;
    private bool _randomEvents = true;
    private bool _showPlayHints = true;

    // The designated hitter rule for the game. WHY: the default keeps every game as it was; "Historical" lets the home
    // team's league and year decide, and "Pitchers bat" removes the designated hitter for both teams.
    private DesignatedHitterSetting _dhSetting = DesignatedHitterSetting.DesignatedHitter;

    private bool UsesDesignatedHitter => DesignatedHitterRules.Applies(_dhSetting, _teamOptions[_homeIdx]);

    private static string DesignatedHitterLabel(DesignatedHitterSetting setting) => setting switch
    {
        DesignatedHitterSetting.DesignatedHitter => "Designated hitter (both teams)",
        DesignatedHitterSetting.Historical => "Historical (the home team's league and year)",
        _ => "Pitchers bat (no designated hitter)",
    };

    private string DesignatedHitterHelp => _dhSetting switch
    {
        DesignatedHitterSetting.DesignatedHitter => "A designated hitter bats for the pitcher on both teams.",
        DesignatedHitterSetting.PitchersBat => "The pitchers bat: expect bunts, pinch hitters for the pitcher and double switches.",
        _ => UsesDesignatedHitter
            ? $"The {_teamOptions[_homeIdx].Season} {_teamOptions[_homeIdx].League} used a designated hitter, so both teams have one."
            : $"The {_teamOptions[_homeIdx].Season} {_teamOptions[_homeIdx].League} had no designated hitter, so the pitchers bat.",
    };

    // Which computer manager runs each side when the computer manages it (ids from the manager catalog).
    private string _visitorManagerId = ManagerCatalog.DefaultId;
    private string _homeManagerId = ManagerCatalog.DefaultId;
    private bool _mobileLineupVisitor = true;
    private bool _mobilePitchingExpanded;
    private bool _scoreObserved;
    private ElementReference _fullScore;
    private ElementReference _mobileScore;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_game?.State is not null && !_scoreObserved)
        {
            await JS.InvokeVoidAsync("mlbMobileScore.observe", _fullScore, _mobileScore);
            _scoreObserved = true;
        }
    }

    // Starting pitchers picked before the game, by side and team (anyone not picked starts the ace)
    private readonly Dictionary<(bool Visitor, int TeamId), int> _starters = [];

    private int StarterFor(Team team, bool visitor) =>
        _starters.TryGetValue((visitor, team.Id), out var id) && team.Pitchers.Any(p => p.Id == id)
            ? id
            : team.DefaultStarter.Id;

    private static string BaseSituation(GameState s)
    {
        var runners = new List<string>();
        if (s.RunnerOnFirst is { } first) runners.Add($"1B {first.Player.Name}");
        if (s.RunnerOnSecond is { } second) runners.Add($"2B {second.Player.Name}");
        if (s.RunnerOnThird is { } third) runners.Add($"3B {third.Player.Name}");
        return runners.Count == 0 ? "Bases empty" : string.Join(" · ", runners);
    }
    private GameSnapshot? _saved;
    private string? _resumeError;
    private GameService _game = null!;
    private PlayResult? _lastResult;
    private PlayScript? _replay;   // the last play as it was shown, for the Replay button (never saved with the game)
    private CancellationTokenSource? _cpuCts;

    // The animated field (Detailed view only). While it plays a play, the page keeps showing the situation
    // from before it: the game state has already moved on, so the page is not redrawn until the play is over.
    private DetailedFieldView? _detailed;
    private bool _animating;
    private DefensiveAlignment? _previewAlignment;
    private bool _holdRender;
    private bool _injuryShown;                // the injury scene has already shown a hurt man leaving; the replacement just appears
    private bool _pendingIntro;                 // a new game waits for the field to come up before it starts
    private PrePlaySnapshot? _shown;            // the situation the animated field last showed (for scenes between plays)

    protected override bool ShouldRender() => !_holdRender;

    // Lineups edited before the game, by team ID (teams without an entry use their default)
    private readonly Dictionary<int, List<LineupSlot>> _customLineups = [];

    protected override async Task OnInitializedAsync()
    {
        Cast.Changed += OnCastChanged;
        _game = new GameService(Resolver, CpuManager, Dice, ManagerCatalog.Default);
        await ViewPrefs.InitAsync();
        try
        {
            _teamOptions = [.. await Teams.GetTeamsAsync()];
            _homeIdx = Math.Min(1, _teamOptions.Length - 1);
            _stadiums = await Teams.GetStadiumsAsync();
            _saved = await Saves.LoadAsync();
        }
        catch (Exception ex) when (ex is HttpRequestException or System.Text.Json.JsonException)
        {
            _loadError = "Could not load team data.";
        }
    }

    private async Task StartGame()
    {
        _previewAlignment = null;
        _scoreObserved = false;
        _lastResult = null;
        _replay = null;
        bool visitorHuman = _humanSide is HumanSide.Visitor or HumanSide.Both;
        bool homeHuman = _humanSide is HumanSide.Home or HumanSide.Both;
        _game.StartGame(
            _teamOptions[_visitorIdx],
            _teamOptions[_homeIdx],
            visitorHuman ? ManagerControl.Human : ManagerControl.Computer,
            homeHuman ? ManagerControl.Human : ManagerControl.Computer,
            stadium: ChosenPark(),
            visitorLineupSlots: LineupFor(_teamOptions[_visitorIdx], visitor: true),
            homeLineupSlots: LineupFor(_teamOptions[_homeIdx], visitor: false),
            options: (_randomEvents ? GameOptions.Standard : GameOptions.None) with
            {
                DesignatedHitter = _dhSetting,
                ShowPlayHints = _showPlayHints,
            },
            visitorStarterId: StarterFor(_teamOptions[_visitorIdx], visitor: true),
            homeStarterId: StarterFor(_teamOptions[_homeIdx], visitor: false),
            visitorManagerId: _visitorManagerId,
            homeManagerId: _homeManagerId);
        bool detailed = ViewPrefs.View == FieldViewMode.Detailed;
        if (detailed)
        {
            // NOTE: the animated field introduces the game (and plays the sound) once it is up; play starts after that.
            // WHY: set before the first await. The field can come up, and ask for the introduction, while the game is
            // still being saved; if the flag is not set by then the introduction is skipped, nothing schedules the
            // computer's first turn, and a game with no human to act sits on "Computer deciding..." for ever.
            _pendingIntro = true;
            _shown = null;
        }
        await SaveGame();
        if (detailed) return;
        _ = Sound.PlayAsync("playball");
        ScheduleComputerTurnIfNeeded();
    }

    private Stadium ChosenPark() =>
        Teams.FindStadium(_stadiumChoice == HomePark ? _teamOptions[_homeIdx].StadiumId : _stadiumChoice);

    private string ParkNameOf(Team team) => Teams.FindStadium(team.StadiumId).Name;

    // ── Save and resume ──────────────────────────────────────────────────────

    // WHY: every change to the game passes through here (start, each play, substitutions, injuries), so this is also
    // where the TV is kept up to date: one place to hook instead of one per change.
    // NOTE: ResumeGame does not call this, so it tells the TV itself.
    private async Task SaveGame()
    {
        if (_game.State is null) return;
        await Saves.SaveAsync(_game.State);
        await PublishToTv();
    }

    private async Task PublishToTv()
    {
        if (_game.State is { } state)
            await Cast.PublishAsync(state, ViewPrefs.View == FieldViewMode.Detailed);
    }

    private async Task ResumeGame()
    {
        if (_saved is null) return;
        try
        {
            _game.Resume(_saved, id => _teamOptions.FirstOrDefault(t => t.Id == id), id => Teams.FindStadium(id));
        }
        catch (InvalidOperationException ex)
        {
            _resumeError = ex.Message + " It has been discarded.";
            await Saves.ClearAsync();
            _saved = null;
            return;
        }

        _lastResult = null;
        _replay = null;
        _saved = null;
        _resumeError = null;
        _shown = null;
        await PublishToTv();   // WHY: a resumed game changes nothing here yet, so SaveGame has not run; the TV would stay blank
        await OfferInjuryReplacement();
        ScheduleComputerTurnIfNeeded();
    }

    private async Task DiscardSave()
    {
        await Saves.ClearAsync();
        _saved = null;
        _resumeError = null;
    }

    // The order for the rule in force: an edited one is fitted to it (a lineup made for the other rule goes back to the
    // default, and when the pitcher bats the starter chosen now takes the pitcher's spot).
    private IReadOnlyList<LineupSlot> LineupFor(Team team, bool visitor)
    {
        _customLineups.TryGetValue(team.Id, out var custom);
        return LineupRules.Adapt(team, custom, UsesDesignatedHitter, StarterOf(team, visitor));
    }

    private Player StarterOf(Team team, bool visitor) => team.Pitchers.First(p => p.Id == StarterFor(team, visitor));

    private async Task EditLineup(Team team, bool visitor)
    {
        var parameters = new DialogParameters<LineupEditorDialog>
        {
            { x => x.Team, team },
            { x => x.Current, LineupFor(team, visitor) },
            { x => x.UsesDesignatedHitter, UsesDesignatedHitter },
            { x => x.Starter, StarterOf(team, visitor) },
        };
        var dialog = await DialogService.ShowAsync<LineupEditorDialog>(
            "Lineup", parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: List<LineupSlot> slots })
            _customLineups[team.Id] = slots;
    }

    private bool TwoHumans =>
        _game.State is { VisitorControl: ManagerControl.Human, HomeControl: ManagerControl.Human };

    // With one human it is their team; with two, start on the team that is batting.
    private bool HumanIsVisitor =>
        _game.State!.VisitorControl == ManagerControl.Human
        && (_game.State.HomeControl != ManagerControl.Human || _game.State.IsTopOfInning);

    private async Task OpenSubstitutions()
    {
        var parameters = new DialogParameters<SubstitutionDialog>
        {
            { x => x.Game, _game },
            { x => x.Visitor, HumanIsVisitor },
            { x => x.AllowSideChoice, TwoHumans },
        };
        var dialog = await DialogService.ShowAsync<SubstitutionDialog>(
            "Substitutions", parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        await dialog.Result;
