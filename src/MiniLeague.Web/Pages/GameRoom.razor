    private async Task SetView(FieldViewMode mode)
    {
        if (_animating) return;
        await ViewPrefs.SetViewAsync(mode);
        await PublishToTv();   // the TV changes field with it
    }

    private async Task SetSpeed(AnimationSpeed speed) => await ViewPrefs.SetSpeedAsync(speed);

    /// <summary>
    /// Shows the last play again, as it was and at the chosen speed. Nothing in the game changes: when it is over
    /// the field goes back to the situation as it stands. A computer turn that was waiting starts after it.
    /// </summary>
    private async Task ReplayAsync()
    {
        if (_animating || _replay is not { } play || _detailed is null || ViewPrefs.View != FieldViewMode.Detailed) return;

        _cpuCts?.Cancel();
        _animating = true;
        StateHasChanged();
        try
        {
            await _detailed.PlayAsync(play with { Cues = [new Cue(0, CueKind.Banner, "REPLAY"), .. play.Cues] }, ViewPrefs.SpeedFactor);
        }
        finally
        {
            _animating = false;
        }
        StateHasChanged();
        ScheduleComputerTurnIfNeeded();
    }

    /// <summary>
    /// In the Detailed view, shows the play that was just made and waits until it is over.
    /// Returns false (having done nothing) in the Classic view, or if the play cannot be shown.
    /// </summary>
    private async Task<bool> AnimateLastPlayAsync()
    {
        if (ViewPrefs.View != FieldViewMode.Detailed || _detailed is null
            || _lastResult is null || _game.LastPrePlay is null || _game.State is null)
            return false;

        PlayScript script;
        try
        {
            script = PlayChoreographer.Build(_game.LastPrePlay, _lastResult, _game.State.PlayByPlay.Count);
        }
        catch (Exception)
        {
            return false;   // showing a play is best effort: fall back to the plain update
        }

        _replay = script;
        _animating = true;
        _holdRender = true;
        try
        {
            // The play is already part of the game, so save it now rather than after the animation.
            await SaveGame();

            // Anyone the managers brought in before the pitch (a reliever, a pinch hitter) walks out first.
            await PlaySceneStepAsync(() => Between(_shown, _game.LastPrePlay));

            bool hasSound = script.Cues.Any(c => c.Kind == CueKind.Sound);
            if (!hasSound) _ = Sound.PlayForResultAsync(_lastResult);   // no template yet: the usual sound

            await _detailed.PlayAsync(script, ViewPrefs.SpeedFactor);

            bool cheered = script.Cues.Any(c => c.Kind == CueKind.Sound && c.Value == "cheer");
            if (hasSound && !cheered && _lastResult.RunsScored > 0 && _lastResult.Outcome != OutcomeType.HomeRun)
                await Sound.PlayAsync("cheer");

            // What happens around the play: the winners' celebration, or a new half-inning and a new pitcher.
            var state = _game.State;
            var happenings = _game.TakeEvents();
            _injuryShown = state.PendingInjury is not null && happenings.Any(e => e.Kind == GameEventKind.Injury);
            if (state.Status == GameStatus.Final)
            {
                if (SceneChoreographer.IsWalkOff(state) && _game.LastPrePlay is { } last)
                    await PlaySceneStepAsync(() => [SceneChoreographer.WalkOff(last, state)]);
                _shown = null;
            }
            else
            {
                try
                {
                    var now = PrePlaySnapshot.Capture(state);
                    // A manager thrown out and a player hurt come first (they belong to the play), then the change of
                    // innings or pitcher, and a rain delay last (it comes at the start of the new half-inning).
                    await PlaySceneStepAsync(() => _game.LastPrePlay is not { } last ? [] :
                        [.. happenings.Where(e => e.Kind == GameEventKind.Ejection).Select(e => SceneChoreographer.Ejection(last, e)),
                         .. happenings.Where(e => e.Kind == GameEventKind.Injury).Select(e => SceneChoreographer.Injury(last, e, now))]);
                    await PlaySceneStepAsync(() => _game.LastPrePlay is { } last ? SceneChoreographer.AfterPlay(last, now) : []);
                    await PlaySceneStepAsync(() =>
                        [.. happenings.Where(e => e.Kind == GameEventKind.RainDelay).Select(e => SceneChoreographer.RainDelay(now, e))]);
                    _shown = now;
                }
                catch (Exception ex) when (ex is InvalidOperationException or KeyNotFoundException or ArgumentException)
                {
                    _shown = null;
                }
            }
        }
        finally
        {
            _holdRender = false;
            _animating = false;
        }
        return true;
    }

    // ── Scenes around the plays ──────────────────────────────────────────────

    private static IReadOnlyList<PlayScript> Between(PrePlaySnapshot? from, PrePlaySnapshot? to) =>
        from is null || to is null ? [] : SceneChoreographer.Between(from, to);

    // Builds and plays some scenes. Showing a scene is best effort: one that cannot be built is left out.
    private async Task PlaySceneStepAsync(Func<IReadOnlyList<PlayScript>> build)
    {
        if (_detailed is null) return;
        IReadOnlyList<PlayScript> scenes;
        try { scenes = build(); }
        catch (Exception) { return; }
        foreach (var scene in scenes)
            await _detailed.PlayAsync(scene, ViewPrefs.SpeedFactor);
    }

    // After the managers made changes outside a play (the substitutions or injury windows): show who walks on and off.
    private async Task ShowChangesAsync(bool quiet = false)
    {
        if (ViewPrefs.View != FieldViewMode.Detailed || _detailed is null || _game.State is not { Status: GameStatus.InProgress } state)
            return;
        PrePlaySnapshot now;
        try { now = PrePlaySnapshot.Capture(state); }
        catch (Exception ex) when (ex is InvalidOperationException or KeyNotFoundException or ArgumentException) { return; }
        var before = _shown;
        _shown = now;
        if (before is null || _animating || quiet) return;

        _animating = true;
        _holdRender = true;
        try { await PlaySceneStepAsync(() => Between(before, now)); }
        finally
        {
            _holdRender = false;
            _animating = false;
        }
    }

    private async Task VisitMoundAsync()
    {
        if (ViewPrefs.View != FieldViewMode.Detailed || _detailed is null || _animating
            || _game.State is not { Status: GameStatus.InProgress } state || _game.LastPrePlay is not { } last
            || state.CurrentInning != last.Inning || state.IsTopOfInning != last.IsTop)
            return;

        _animating = true;
        try { await PlaySceneStepAsync(() => [SceneChoreographer.MoundVisit(PrePlaySnapshot.Capture(state))]); }
        finally { _animating = false; }
    }

    // The new game: the teams come out, the lineups are announced and the home team takes the field.
    private async Task OnDetailedReady()
    {
        if (_game.State is not { } state) return;
        if (!_pendingIntro)
        {
            // The animated view was switched on in the middle of a game.
            try { _shown = PrePlaySnapshot.Capture(state); }
            catch (Exception ex) when (ex is InvalidOperationException or KeyNotFoundException or ArgumentException) { }
            return;
        }

        _pendingIntro = false;
        _animating = true;
        _holdRender = true;
        try
        {
            await PlaySceneStepAsync(() => [SceneChoreographer.PlayBall(state)]);
            try { _shown = PrePlaySnapshot.Capture(state); }
            catch (Exception ex) when (ex is InvalidOperationException or KeyNotFoundException or ArgumentException) { }
        }
        finally
        {
            _holdRender = false;
            _animating = false;
        }
        StateHasChanged();
        ScheduleComputerTurnIfNeeded();
    }

    // WHY: a TV was connected or disconnected: the field moves there or comes back here.
    // NOTE: ShouldRender() is false while a play is shown, so a change during an animation takes effect when it ends.
    private void OnCastChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        _ = JS.InvokeVoidAsync("mlbMobileScore.disconnect");
        Cast.Changed -= OnCastChanged;
        _cpuCts?.Cancel();
    }

    // ── Display helpers ──────────────────────────────────────────────────────

    private static string InningLabel(GameState s)
    {
        string half = s.IsTopOfInning ? "▲" : "▼";
        return $"{half} {s.CurrentInning}";
    }

    private static string Avg(BatterStats b)
    {
        string raw = b.BattingAverage.ToString("F3");
        return raw.StartsWith("0") ? raw[1..] : raw;  // strip leading 0 → .320
    }

    private static string PositionLabel(MiniLeague.Engine.Models.Position p) => p switch
    {
        MiniLeague.Engine.Models.Position.P      => "P",
        MiniLeague.Engine.Models.Position.C      => "C",
        MiniLeague.Engine.Models.Position.First  => "1B",
        MiniLeague.Engine.Models.Position.Second => "2B",
        MiniLeague.Engine.Models.Position.Third  => "3B",
        MiniLeague.Engine.Models.Position.Short  => "SS",
        MiniLeague.Engine.Models.Position.Left   => "LF",
        MiniLeague.Engine.Models.Position.Center => "CF",
        MiniLeague.Engine.Models.Position.Right  => "RF",
        MiniLeague.Engine.Models.Position.DH     => "DH",
        _ => p.ToString()
    };

    private static string BatHandLabel(BatHand b) => b switch
    {
        BatHand.Left => "L", BatHand.Right => "R", _ => "S"
    };

    private static Color ConditionColor(PitcherCondition c) => c switch
    {
        PitcherCondition.Fresh     => Color.Success,
        PitcherCondition.Ok        => Color.Info,
        PitcherCondition.Tiring    => Color.Warning,
        PitcherCondition.Tired     => Color.Error,
        PitcherCondition.Exhausted => Color.Dark,
        _ => Color.Default
    };

}
