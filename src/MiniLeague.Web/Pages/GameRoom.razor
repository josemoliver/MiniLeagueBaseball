    private async Task OpenHint()
    {
        if (_animating || !_game.IsHumanTurn || _game.State is not
            { Status: GameStatus.InProgress, PendingInjury: null, Options.ShowPlayHints: true } state)
            return;
        var initialSide = _game.OffenseIsHuman && _game.CanUsePlayHint(state.IsTopOfInning)
            ? PlayHintSide.Offense : PlayHintSide.Defense;
        var initial = await RequestHint(initialSide);
        if (initial is null) return;
        var parameters = new DialogParameters<PlayHintDialog>
        {
            { x => x.InitialHint, initial },
            { x => x.HasBatting, _game.OffenseIsHuman },
            { x => x.HasFielding, _game.DefenseIsHuman },
            { x => x.RequestSide, RequestHint },
            { x => x.CanUseSide, CanUseHintSide },
        };
        var dialog = await DialogService.ShowAsync<PlayHintDialog>("Show Hint", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true });
        await dialog.Result;
        try { await JS.InvokeVoidAsync("mlbKeys.focusHint"); }
        catch (JSException) { }
    }

    private bool CanOpenHint() => CanUseHintSide(PlayHintSide.Offense) || CanUseHintSide(PlayHintSide.Defense);

    private bool CanUseHintSide(PlayHintSide side)
    {
        if (_game.State is not { } state) return false;
        return side == PlayHintSide.Offense
            ? _game.OffenseIsHuman && _game.CanUsePlayHint(state.IsTopOfInning)
            : _game.DefenseIsHuman && _game.CanUsePlayHint(!state.IsTopOfInning);
    }

    private string HintButtonLabel()
    {
        if (_game.State is not { } state) return "";
        int batting = _game.PlayHintsRemaining(state.IsTopOfInning);
        int fielding = _game.PlayHintsRemaining(!state.IsTopOfInning);
        if (_game.OffenseIsHuman && _game.DefenseIsHuman) return $"Bat {batting} · Field {fielding}";
        return $"{(_game.OffenseIsHuman ? batting : fielding)} left";
    }

    private async Task<PlayHint?> RequestHint(PlayHintSide side)
    {
        if (_animating || !_game.IsHumanTurn || _game.State is not { } state || !CanUseHintSide(side))
            return null;
        bool visitor = side == PlayHintSide.Offense ? state.IsTopOfInning : !state.IsTopOfInning;
        var alignment = _previewAlignment ?? (state.IsTopOfInning ? state.HomeAlignment : state.VisitorAlignment);
        var hint = PlayHintAdvisor.Get(state, side, side == PlayHintSide.Offense ? alignment : null);
        if (!_game.TryUsePlayHint(visitor)) return null;
        await SaveGame();
        StateHasChanged();
        return hint;
    }

